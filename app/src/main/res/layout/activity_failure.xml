<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="打卡需要你处理" android:textSize="30sp" android:textColor="#A42424" android:textStyle="bold" />
    <TextView android:id="@+id/failureDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:textSize="20sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="打开飞书不会停止响铃。请先核对是否已有记录，避免重复打卡。关闭闹钟不会将任务记为成功。" android:textSize="16sp" />
    <Button android:id="@+id/openFeishu" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="打开飞书（继续响铃）" />
    <Button android:id="@+id/stopAll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="关闭全部闹钟" />
</LinearLayout>
</ScrollView>
